{
  "name": "platform-sys",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm build:contracts && concurrently -k -n web,api -c cyan,magenta \"pnpm dev:web\" \"pnpm dev:api\"",
    "dev:all": "pnpm build:contracts && concurrently -n web,api,stock -c cyan,magenta,green --kill-others-on-fail \"pnpm dev:web\" \"pnpm dev:api\" \"pnpm dev:stockframe\"",
    "dev:web": "vite --port 8080 --strictPort",
    "dev:api": "pnpm --filter @platform/server dev",
    "dev:stockframe": "python tools/stockframe/tools/service/start.pyw",
    "pm2:start": "pnpm build:contracts && node scripts/pm2.cjs startOrReload ecosystem.config.cjs",
    "pm2:restart": "node scripts/pm2.cjs startOrReload ecosystem.config.cjs",
    "pm2:stop": "node scripts/pm2.cjs stop platform-web platform-api platform-stockframe",
    "pm2:status": "node scripts/pm2.cjs list",
    "pm2:logs": "node scripts/pm2.cjs logs platform-web platform-api platform-stockframe",
    "build:contracts": "pnpm --filter @platform/contracts build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && pnpm --filter @platform/server typecheck",
    "build": "pnpm build:contracts && pnpm typecheck && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "start": "pnpm --filter @platform/server start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@platform/contracts": "workspace:*",
    "@tresjs/cientos": "^5.10.1",
    "@tresjs/core": "^5.10.1",
    "@tresjs/post-processing": "^3.11.1",
    "pinia": "^3.0.4",
    "three": "^0.187.0",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.1",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.14"
  }
}
